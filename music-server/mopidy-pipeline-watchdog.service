# Watchdog that auto-recovers when Mopidy's gstreamer pipeline emits any
# "GStreamer error" but playback stays "playing" (no audio out). Tiered:
# stop/play first, then `systemctl restart mopidy` on the 3rd strike inside
# the rolling window. Rate-limited inside the script.
#
# Copy to /etc/systemd/system/mopidy-pipeline-watchdog.service

[Unit]
Description=Mopidy gstreamer pipeline watchdog
After=mopidy.service
Wants=mopidy.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mopidy-pipeline-watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
